<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NoteinDesktopViewer.FolderInputDialog"
        Title="Target Folder"
        Width="400" Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Enter the folder name to search in Google Drive:" />
        <TextBox x:Name="FolderNameInput" Text="NoteInDataSync" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="OK" Click="OnOkClick" Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
