<Window
    x:Class="NoteinDesktopViewer.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NoteinDesktopViewer"
    Width="600"
    Height="500"
    d:DesignHeight="500"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <DockPanel Margin="16">
        <!-- Top bar: login/logout controls -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button x:Name="LoginButton" Content="Sign in with Google" Click="OnLoginClick" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Not signed in" />
            <Button x:Name="LogoutButton" Content="Sign out" Click="OnLogoutClick" IsVisible="False" />
        </StackPanel>

        <!-- Error message -->
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Red"
                   TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="False" />

        <!-- Loading / sync progress indicator -->
        <StackPanel x:Name="LoadingPanel" DockPanel.Dock="Top" Orientation="Horizontal"
                    Spacing="8" Margin="0,0,0,8" IsVisible="False">
            <ProgressBar IsIndeterminate="True" Width="120" Height="16" />
            <TextBlock x:Name="LoadingText" VerticalAlignment="Center" Text="Loading..." />
        </StackPanel>

        <!-- Content area: file list + conversion log -->
        <Grid RowDefinitions="*,Auto,*">
            <!-- File list -->
            <ListBox x:Name="FileListBox" Grid.Row="0" />

            <!-- Splitter label -->
            <TextBlock Grid.Row="1" Text="Conversion Log" FontWeight="Bold"
                       Margin="0,8,0,4" IsVisible="{Binding #LogBox.IsVisible}" />

            <!-- Log output -->
            <TextBox x:Name="LogBox" Grid.Row="2"
                     IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas,Courier New,monospace" FontSize="12"
                     IsVisible="False" />
        </Grid>
    </DockPanel>
</Window>
