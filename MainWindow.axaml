<Window
    x:Class="NoteinDesktopViewer.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:NoteinDesktopViewer"
    Title="NoteinDesktopViewer"
    Width="1100"
    Height="700"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <DockPanel Margin="16">
        <!-- Top bar: login/logout controls -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button x:Name="LoginButton" Content="Sign in with Google" Click="OnLoginClick" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Not signed in" />
            <Button x:Name="LogoutButton" Content="Sign out" Click="OnLogoutClick" IsVisible="False" />
            <Button x:Name="ManuelSyncButton" Content="Sync" Click="OnManuelSyncClick" IsEnabled="False"/>
        </StackPanel>

        <!-- Error message -->
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Red"
                   TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="False" />

        <!-- Loading / sync progress indicator -->
        <StackPanel x:Name="LoadingPanel" DockPanel.Dock="Top" Orientation="Horizontal"
                    Spacing="8" Margin="0,0,0,8" IsVisible="False">
            <ProgressBar IsIndeterminate="True" Width="120" Height="16" />
            <TextBlock x:Name="LoadingText" VerticalAlignment="Center" Text="Loading..." />
        </StackPanel>

        <!-- Main content: left panel (list + log) | right panel (PDF viewer) -->
        <Grid ColumnDefinitions="300,8,*">
            <!-- Left panel -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto">
                <!-- File list -->
                <ListBox x:Name="FileListBox" Grid.Row="0"
                         SelectionChanged="OnFileSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:FileItem">
                            <Panel>
                                <Border Background="#44FF0000" IsVisible="{Binding !HasPdf}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="40" Height="50">
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                        <TextBlock Text="⚠️" Foreground="Red" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPdf}" />
                                    </Panel>
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Splitter label -->
                <TextBlock Grid.Row="1" Text="Conversion Log" FontWeight="Bold"
                           Margin="0,8,0,4" IsVisible="{Binding #LogBox.IsVisible}" />

                <!-- Log output -->
                <TextBox x:Name="LogBox" Grid.Row="2"
                         IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MaxHeight="150"
                         FontFamily="Consolas,Courier New,monospace" FontSize="12"
                         IsVisible="False" />
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                          Background="Gray" Width="4" />

            <!-- Right panel: PDF viewer -->
            <Grid Grid.Column="2">
                <TextBlock x:Name="PdfPlaceholder"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Select a file to view its PDF" Opacity="0.5" />
                <NativeWebView x:Name="PdfWebView" IsVisible="False" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
