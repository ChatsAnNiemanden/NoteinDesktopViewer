<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Only use Native AOT when Google Drive is disabled -->
    <PublishAot Condition="'$(DisableGoogleDrive)' == 'true'">true</PublishAot>
    <PublishAot Condition="'$(DisableGoogleDrive)' != 'true'">false</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Set to true to build without Google Drive support -->
    <DisableGoogleDrive Condition="'$(DisableGoogleDrive)' == ''">false</DisableGoogleDrive>
  </PropertyGroup>

  <PropertyGroup>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != 'linux-x64'">true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DisableGoogleDrive)' == 'true'">
    <DefineConstants>$(DefineConstants);DISABLE_GOOGLE_DRIVE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.16.4" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\PdfViewer.html" />
    <EmbeddedResource Include="$(PdfJsDir)build/pdf.mjs" LogicalName="NoteinDesktopViewer.Assets.pdf.mjs" />
    <EmbeddedResource Include="$(PdfJsDir)build/pdf.worker.mjs" LogicalName="NoteinDesktopViewer.Assets.pdf.worker.mjs" />
  </ItemGroup>

  <PropertyGroup>
    <PdfJsVersion>4.10.38</PdfJsVersion>
    <PdfJsDir>$(BaseIntermediateOutputPath)pdfjs/</PdfJsDir>
    <PdfJsZip>$(PdfJsDir)pdfjs-$(PdfJsVersion)-dist.zip</PdfJsZip>
  </PropertyGroup>

  <Target Name="DownloadPdfJs" BeforeTargets="AssignTargetPaths;BeforeCompile" Condition="!Exists('$(PdfJsDir)build/pdf.mjs')">
    <MakeDir Directories="$(PdfJsDir)" />
    <DownloadFile
      SourceUrl="https://github.com/mozilla/pdf.js/releases/download/v$(PdfJsVersion)/pdfjs-$(PdfJsVersion)-dist.zip"
      DestinationFolder="$(PdfJsDir)"
      DestinationFileName="pdfjs-$(PdfJsVersion)-dist.zip"
      SkipUnchangedFiles="true" />
    <Unzip
      SourceFiles="$(PdfJsZip)"
      DestinationFolder="$(PdfJsDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup Condition="'$(DisableGoogleDrive)' != 'true'">
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.76.0.4261" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableGoogleDrive)' != 'true'">
    <None Update="client_secrets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
